{
  "schemaVersion": 1,
  "id": "smoothhud",
  "version": "${version}",
  "name": "SmoothHud",
  "description": "Animate the selected hotbar slot highlight when switching slots.",
  "authors": [
    "treegfx"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/smooth-hud",
    "sources": "https://github.com/treegfx2/smoothHud",
    "issues": "https://github.com/treegfx2/smoothHud/issues"
  },
  "icon": "assets/smoothhud/icon.png",
  "environment": "client",
  "mixins": [
    "smoothhud.mixins.json"
  ],
  "entrypoints": {
    "modmenu": [
      "dev.smoothhud.ModMenu"
    ],
    "main": [
      "dev.smoothhud.ConfigManager"
    ]
  },
  "resources": [
    "assets.smoothhud"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
